<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Puente nativo de la fase 2 (ADR 0002): el mundo web le pide, por WebSocket local, que
       active, aparque y reciba ratón una ventana capturada. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>infinite-desk-bridge</AssemblyName>
    <RootNamespace>InfiniteDesk.Puente</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
</Project>
