{
  "name": "infinite-desk",
  "version": "1.0.0",
  "description": "Un mundo 3D con una isla por repo y tus ventanas como pantallas flotantes",
  "scripts": {
    "grafo": "node tools/exportar.mjs",
    "noticias": "node tools/noticias.mjs",
    "carpeta": "node tools/proyectos.mjs",
    "build": "esbuild src/main.js --bundle --format=iife --minify --target=chrome110 --outfile=wallpaper/infinite-desk.js",
    "mundo": "node tools/servir.mjs",
    "test": "node --test \"tests/*.test.js\"",
    "tipos": "tsc -p .",
    "terminado": "npm run tipos && npm test && npm run grafo && npm run build && npm run puente && node tools/comprobar.mjs && node tools/humo.mjs",
    "fondo": "node tools/fondo.mjs",
    "alternar-fondo": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/alternar-fondo.ps1",
    "parar": "node tools/parar.mjs",
    "diagnostico": "node tools/diagnostico.mjs",
    "probar-puente": "node tools/probar-puente.mjs",
    "puente": "dotnet build puente -c Release --nologo -v q"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
